# ==========================================
# Multimodal Construction Intelligence Platform
# Root .gitignore
# ==========================================

# ----------------- Environment Variables & Secrets -----------------
.env
.env.*
!.env.example
backend/.env

# ----------------- Python Artifacts & Caches -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type Checking
.mypy_cache/
.pytype/
.ruff_cache/

# ----------------- Node.js & React Frontend -----------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Logs & Package Manager Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------- Database & User Uploads -----------------
# Ignore local SQLite databases and uploaded inspection images
*.db
*.sqlite3
backend/construction.db
backend/uploads/*
!backend/uploads/.gitkeep

# ----------------- IDEs & Editors -----------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ----------------- OS Generated Files -----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

