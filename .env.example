# Multimodal Construction Intelligence Platform Environment Variables

# Google Gemini API Key (multimodal vision + reasoning)
# Get a key at: https://aistudio.google.com/
GOOGLE_API_KEY=

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenWeatherMap API Key (leave empty for demo/mock weather)
WEATHER_API_KEY=

# Backend Host & Port
PORT=8000
HOST=0.0.0.0

